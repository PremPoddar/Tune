# Copy to keystore.properties (git-ignored) and fill in to build a signed release.
# Make the keystore once with:
#   keytool -genkeypair -v -keystore upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
# Always sign with the same key: Play ties the app to its upload certificate. One key can sign several apps.
# An absolute path is safest: a relative one resolves against app/, not the project root.
storeFile=/absolute/path/to/upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
